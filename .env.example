# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/pace_ai_edu

# Python venv binary (use absolute path on Mac Mini)
# e.g. /Users/compsci/pace-ai-edu/venv/bin/python3
PYTHON_BIN=python3

# Express Backend
PORT=3001
# Keep as 'development' to use DEV_EMAIL auth fallback (no Cloudflare Zero Trust needed)
NODE_ENV=development
# The email identity used for the demo — set this to a real-looking Pace teacher email
DEV_EMAIL=jsmith@paceacademy.org

# LLM (LM Studio — must be running with models loaded)
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL_NAME=google/gemma-4-31b
LLM_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
# Optional: comma-separated list of LLM base URLs for round-robin distribution.
# Embeddings always use LLM_BASE_URL (main machine only).
# LLM_ENDPOINTS=http://100.104.98.2:1234/v1,http://100.116.114.61:1234/v1,http://100.95.25.37:1234/v1,http://100.110.5.126:1234/v1

# Logging
LOG_FILE_PATH=logs/pipeline.log
LOG_LEVEL=INFO

# Pipeline Tuning
SIMILARITY_LOW_THRESHOLD=0.55
EMBEDDING_DIMENSIONS=768
MAX_LLM_CONCURRENT_REQUESTS=4
LLM_RETRY_ATTEMPTS=2
LLM_RETRY_DELAY_SECONDS=5
MAX_ARTICLE_AGE_DAYS=180
MIN_ARTICLES_PER_TEACHER=3
MAX_ARTICLES_PER_TEACHER=5

# RSS Feeds (comma separated)
RSS_FEEDS=https://www.cultofpedagogy.com/feed/,https://www.middleweb.com/feed/,https://www.teachthought.com/feed/

# Pace Academy Mission Statement
PACE_MISSION="Pace Academy develops curious, ethical, and skilled individuals who are prepared to make a positive difference in the world through academic excellence, character development, and a commitment to community."
